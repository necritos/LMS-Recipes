DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-in-production

# Local: SQLite (db.sqlite3). Prod: PostgreSQL vía DATABASE_URL.
# DATABASE_URL=postgres://recetario:recetario@localhost:5432/recetario

ALLOWED_HOSTS=localhost,127.0.0.1
# CORS — en producción ya hay wildcards (*.web.app, *.petralicious.com/sk).
# Extra exactos / Firebase legado:
# CORS_ALLOWED_ORIGINS=https://petralicious-aac3c.firebaseapp.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
# CORS_ALLOW_LOCALHOST=true


# JWT
JWT_ACCESS_DAYS=7
JWT_REFRESH_DAYS=7

# Site
SITE_NAME=Recetario

# Celery (local: make up && make worker)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# MAIL_ASYNC=true

# Google OAuth
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Stripe se configura por API admin (no env):
# PATCH /api/v1/admin/site/stripe/

# Bunny.net se configura por API admin (no env):
# PATCH /api/v1/admin/site/bunny/

# Firebase Storage se configura por API admin:
# PATCH /api/v1/admin/site/settings/  (firebase_enabled, bucket, credentials JSON)
# Fallback local: filesystem. Fallback prod sin Firebase: DO Spaces (abajo).

# Digital Ocean Spaces (prod)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# AWS_S3_REGION_NAME=nyc3

# Mailchimp se configura por API admin (no env):
# PATCH /api/v1/admin/site/mailchimp/

# Email fallback SMTP (si no hay Mailchimp Transactional)
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
